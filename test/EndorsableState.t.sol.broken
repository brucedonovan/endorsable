pragma solidity ^0.8.13;

import "lib/forge-std/src/Test.sol";
import "../src/EndorsableState.sol";

/**
 * @title EndorsableStateTest
 * @dev Test the simplified state-based endorsement system
 */
contract EndorsableStateTest is Test {
    EndorsableState scoreContract;
    
    address owner = address(0x1);
    address alice = address(0x2);
    address bob = address(0x3);
    address charlie = address(0x4);
    
    address[] initialEndorsers = [alice, bob];
    
    function setUp() public {
        vm.prank(owner);
        scoreContract = new EndorsableState(initialEndorsers);
    }
    
    function testSubmitScore() public {
        vm.prank(alice);
        scoreContract.submitScore("Alice", 100);
        
        ScoreEndorsementState.Score memory aliceScore = scoreContract.getScore(alice);
        assertEq(aliceScore.value, 100);
        assertEq(aliceScore.playerName, "Alice");
        assertTrue(aliceScore.exists);
    }
    
    function testStateEndorsementFlow() public {
        // Alice submits a score
        vm.prank(alice);
        scoreContract.submitScore("Alice", 100);
        
        // Alice requests endorsement from Bob
        vm.prank(alice);
        scoreContract.requestScoreEndorsement(bob, "Please endorse my score");
        
        // Check that Bob has REQUESTED status (1) for Alice's score
        uint8 status = scoreContract.getScoreEndorsementStatus(alice, bob);
        assertEq(status, 1, "Should be REQUESTED");
        
        // Bob endorses Alice's score
        vm.prank(bob);
        scoreContract.endorseState(alice, "score", "Great score!");
        
        // Check that Bob now has ENDORSED status (2) for Alice's score  
        status = scoreContract.getScoreEndorsementStatus(alice, bob);
        assertEq(status, 2, "Should be ENDORSED");
        
        // Bob revokes his endorsement
        vm.prank(bob);
        scoreContract.revokeStateEndorsement(alice, "score", "Changed my mind");
        
        // Check that Bob now has UNASSIGNED status (0)
        status = scoreContract.getScoreEndorsementStatus(alice, bob);
        assertEq(status, 0, "Should be UNASSIGNED");
    }
    
    function testCannotEndorseWithoutRequest() public {
        // Alice submits a score
        vm.prank(alice);
        scoreContract.submitScore("Alice", 100);
        
        // Charlie tries to endorse Alice's score without a request
        vm.prank(charlie);
        vm.expectRevert("Not requested");
        scoreContract.endorseState(alice, "score", "Trying to endorse without request");
    }
    
    function testMultipleEndorsers() public {
        // Alice submits a score
        vm.prank(alice);
        scoreContract.submitScore("Alice", 100);
        
        // Alice requests endorsements from Bob and Charlie
        vm.prank(alice);
        scoreContract.requestScoreEndorsement(bob, "Please endorse from Bob");
        
        vm.prank(alice);
        scoreContract.requestScoreEndorsement(charlie, "Please endorse from Charlie");
        
        // Bob endorses Alice's score
        vm.prank(bob);
        scoreContract.endorseState(alice, "score", "Bob endorses");
        
        // Charlie endorses Alice's score
        vm.prank(charlie);
        scoreContract.endorseState(alice, "score", "Charlie endorses");
        
        // Check both endorsements
        assertEq(scoreContract.getScoreEndorsementStatus(alice, bob), 2, "Bob should have endorsed");
        assertEq(scoreContract.getScoreEndorsementStatus(alice, charlie), 2, "Charlie should have endorsed");
        
        // Test endorsement counting
        address[] memory endorsers = new address[](2);
        endorsers[0] = bob;
        endorsers[1] = charlie;
        
        uint256 count = scoreContract.getScoreEndorsementCount(alice, endorsers);
        assertEq(count, 2, "Should have 2 endorsements");
    }
    
    function testIndependentScores() public {
        // Alice and Bob both submit scores
        vm.prank(alice);
        scoreContract.submitScore("Alice", 100);
        
        vm.prank(bob);
        scoreContract.submitScore("Bob", 200);
        
        // Alice requests endorsement from Charlie for her score
        vm.prank(alice);
        scoreContract.requestScoreEndorsement(charlie, "Endorse Alice");
        
        // Bob requests endorsement from Charlie for his score  
        vm.prank(bob);
        scoreContract.requestScoreEndorsement(charlie, "Endorse Bob");
        
        // Charlie endorses only Alice's score
        vm.prank(charlie);
        scoreContract.endorseState(alice, "score", "Endorsing Alice");
        
        // Check that only Alice's score is endorsed by Charlie
        assertEq(scoreContract.getScoreEndorsementStatus(alice, charlie), 2, "Alice should be endorsed");
        assertEq(scoreContract.getScoreEndorsementStatus(bob, charlie), 1, "Bob should still be requested");
    }
}
